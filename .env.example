NODE_ENV=development
LOG_LEVEL=info

API_PORT=4000
WEB_ORIGIN=http://localhost:5173

DATABASE_URL=postgres://teamos:teamos@localhost:5433/teamos
TEST_DATABASE_URL=postgres://teamos:teamos@localhost:5433/teamos_test
REDIS_URL=redis://localhost:6380

# Sessions
SESSION_TTL_DAYS=14
SESSION_MAX_AGE_DAYS=30

# OAuth apps. Callback URLs (dev):
#   http://localhost:5173/api/auth/google/callback
#   http://localhost:5173/api/auth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email-only sign-in for local development. Refused when NODE_ENV=production.
DEV_LOGIN_ENABLED=true

# Requests per minute
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
